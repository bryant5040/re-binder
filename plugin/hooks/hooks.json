{
  "description": "The binder lock for the Code tab: moves only after his Allow tap, never trash, share or copy, new files only folders and Claude's own, helpers only read, no writes into the binder's folder on this PC, and a log of every Google Drive action. The command form works in Git Bash and in Windows PowerShell 5.1, and blocks if Python is missing or the guard crashes.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$LASTEXITCODE=2; python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" start; LASTEXITCODE=$?; exit $(( 2 * !!$LASTEXITCODE ))",
            "timeout": 60,
            "statusMessage": "Checking the binder lock"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__.+__(update_file|copy_file|trash_file|share_file|create_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "$LASTEXITCODE=2; python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" pre; LASTEXITCODE=$?; exit $(( 2 * !!$LASTEXITCODE ))",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^(AskUserQuestion|Bash|PowerShell|Monitor|Write|Edit|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "$LASTEXITCODE=2; python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" pre; LASTEXITCODE=$?; exit $(( 2 * !!$LASTEXITCODE ))",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(AskUserQuestion|mcp__.+__(update_file|copy_file|trash_file|share_file|create_file))$",
        "hooks": [
          {
            "type": "command",
            "command": "$LASTEXITCODE=2; python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" post; LASTEXITCODE=$?; exit $(( 2 * !!$LASTEXITCODE ))",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^mcp__.+__(search_files|get_file_metadata|list_recent_files)$",
        "hooks": [
          {
            "type": "command",
            "command": "$LASTEXITCODE=2; python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" post; LASTEXITCODE=$?; exit $(( 2 * !!$LASTEXITCODE ))",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^mcp__.+__(read_file_content|download_file_content|get_file_permissions)$",
        "hooks": [
          {
            "type": "command",
            "command": "$LASTEXITCODE=2; python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" post; LASTEXITCODE=$?; exit $(( 2 * !!$LASTEXITCODE ))",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^mcp__.+__(update_file|copy_file|trash_file|share_file|create_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "$LASTEXITCODE=2; python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" post; LASTEXITCODE=$?; exit $(( 2 * !!$LASTEXITCODE ))",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
